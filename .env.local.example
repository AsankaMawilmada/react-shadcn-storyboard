# Copy to .env.local (already gitignored via *.local) and fill in.
# Used by `npm run figma:icons` — see scripts/sync-figma-icons.mjs.

# Figma account settings > Security > Personal access tokens
FIGMA_TOKEN=

# The file key from the file's URL: figma.com/design/<FIGMA_FILE_KEY>/...
FIGMA_FILE_KEY=

# Optional. Page name to scan for icon components (default: "Icons").
# FIGMA_ICONS_PAGE=Icons

# Optional. For component sets with variants, the variant substring to prefer,
# e.g. "Size=24". If unset, the first variant child is used and the fetch
# script prints a summary of variant names so you can tune this.
# FIGMA_ICON_VARIANT=
